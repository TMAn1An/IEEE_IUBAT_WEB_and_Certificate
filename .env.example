APP_NAME="IEEE IUBAT Student Branch"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local-development-only admin accounts, used by database/seeders/AdminUserSeeder.php.
# That seeder refuses to run outside local/testing, so these are never a production
# credential path — the first production Super Admin is created with
# `php artisan app:make-admin` instead (see docs/DEPLOYMENT_CPANEL.md). Never put a
# real password here; these values only ever land in a gitignored local .env.
# SEED_ADMIN_EMAIL=admin@ieee-iubat.test
# SEED_ADMIN_PASSWORD=change-me-locally
# SEED_MANAGER_EMAIL=manager@ieee-iubat.test
# SEED_MANAGER_PASSWORD=change-me-locally

# Certificate number prefix (see config/certificates.php and docs/CERTIFICATE_SYSTEM.md).
# Has a safe default; uncomment only to override. The verification URL is built from the
# named `certificate.verify` route (routes/web.php) + APP_URL above, not a separate setting.
# CERTIFICATE_NUMBER_PREFIX=IEEE-IUBAT
